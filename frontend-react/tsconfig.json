{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      /* Конфіги сторінок, спільні з Vue-версією — див. ../shared/page-configs/README.md */
      "@configs/*": ["../shared/page-configs/*"],
      /* Чиста логіка, спільна з Vue-версією — див. ../shared/core/README.md */
      "@core/*": ["../shared/core/*"],
      "@core": ["../shared/core/index.ts"],
      /* Locale-файли, спільні з Vue-версією — див. ../shared/locales/README.md */
      "@locales/*": ["../shared/locales/*"],
      "@locales": ["../shared/locales/index.ts"]
    }
  },
  "include": ["src", "../shared/page-configs", "../shared/locales"],
  /* shared/core has its own package.json + vitest — не тягнути *.test.ts і
     vitest.config.ts у білд React (vitest тут не встановлений). Модулі ядра
     все одно потрапляють у програму транзитивно, через імпорт з @core. */
  "exclude": ["../shared/core/*.test.ts", "../shared/core/vitest.config.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
